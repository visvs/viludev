---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/features/navigation/Header.astro';
import Hero from '@/features/hero/Hero.astro';
import About from '@/features/about/About.astro';
import Skills from '@/features/skills/Skills.astro';
import Experience from '@/features/experience/Experience.astro';
import Contact from '@/features/contact/Contact.astro';
import Footer from '@/features/footer/Footer.astro';
import { defaultLocale, locales, type Locale } from '@/lib/i18n';

/**
 * One route renders every locale. The alternative — a file per language —
 * duplicates the page composition, so adding a section means remembering to
 * edit both. This cannot drift.
 */
export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} route="/">
  <Header slot="header" locale={locale} />

  <Hero locale={locale} />
  <About locale={locale} />
  <Skills locale={locale} />
  <Experience locale={locale} />
  <Contact locale={locale} />

  <Footer slot="footer" locale={locale} />
</BaseLayout>
