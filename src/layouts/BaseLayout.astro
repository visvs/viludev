---
import BaseHead from '@/components/seo/BaseHead.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { site } from '@/data/site';
import { buildPersonSchema } from '@/lib/seo/personSchema';
import { useTranslations, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  /** Locale-independent route, e.g. `/` or `/contact`. */
  route: string;
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean | undefined;
  /** Emit Person structured data. Off for utility pages like the style guide. */
  structuredData?: boolean | undefined;
}

const { locale, route, title, description, noindex = false, structuredData = true } = Astro.props;

const t = useTranslations(locale);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

const personSchema = buildPersonSchema({
  site,
  description: pageDescription,
  locale,
  knowsAbout: ['React', 'React Native', 'TypeScript', 'Node.js', 'Next.js', 'Astro'],
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      locale={locale}
      route={route}
      noindex={noindex}
    />

    {structuredData && <JsonLd schema={personSchema} />}

    {
      /*
      Runs before first paint so the correct theme is applied without a flash of
      the wrong one. It must stay inline and blocking: a deferred or bundled
      script would paint first and correct itself afterwards, which is exactly
      the flash being avoided. Dark is the default when nothing is stored.
    */
    }
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
        } catch (error) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>

  <body class="bg-surface text-text min-h-dvh">
    {
      /*
      Reading progress. Deliberately a thin bar at the top rather than a
      side rail: it reports position without competing with the content, and it
      is decorative, so it is hidden from assistive technology.
    */
    }
    <div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5" aria-hidden="true">
      <div
        class="scroll-progress from-accent via-secondary to-success h-full w-full bg-gradient-to-r"
      >
      </div>
    </div>

    <a
      href="#main"
      class="bg-accent text-accent-contrast sr-only rounded-md px-4 py-2 font-semibold focus-visible:not-sr-only focus-visible:absolute focus-visible:top-4 focus-visible:left-4 focus-visible:z-50"
    >
      {t('a11y.skipToContent')}
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
