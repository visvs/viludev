---
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { useTranslations, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="hero" class="flex min-h-[min(90svh,52rem)] items-center">
  <Container size="wide">
    <p class="text-secondary font-mono text-sm tracking-wide uppercase">{t('hero.eyebrow')}</p>

    <h1 id="hero-heading" class="text-display mt-4 max-w-5xl leading-[0.95]">
      {site.name}
    </h1>

    <p class="text-text mt-8 max-w-3xl text-2xl leading-tight font-medium text-balance">
      {t('hero.statement')}
    </p>

    <p class="text-text-muted mt-6 max-w-2xl text-lg">{t('hero.intro')}</p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button href="#contact" size="lg">{t('hero.ctaContact')}</Button>
      <Button href={site.social.github} intent="secondary" size="lg" rel="me noopener">
        {t('hero.ctaGithub')}
      </Button>
    </div>
  </Container>
</Section>
