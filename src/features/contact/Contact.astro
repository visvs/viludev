---
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import { site } from '@/data/site';
import { useTranslations, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

type ProfileIcon = 'github' | 'linkedin';

interface Profile {
  label: string;
  href: string;
  handle: string;
  icon: ProfileIcon;
}

const profiles: readonly Profile[] = [
  { label: 'GitHub', href: site.social.github, handle: 'github.com/visvs', icon: 'github' },
  {
    label: 'LinkedIn',
    href: site.social.linkedin,
    handle: 'linkedin.com/in/visv',
    icon: 'linkedin',
  },
];

/** Inline paths rather than an icon library: two icons do not justify a dependency. */
const iconPaths: Record<ProfileIcon, string> = {
  github:
    'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.69-.22.69-.5 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.480-.01 2.82 0 .27.18.6.69.5A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.71h.05c.53-.95 1.83-1.96 3.77-1.96 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21h-4V9Z',
};
---

<Section id="contact" class="bg-surface-sunken relative overflow-hidden">
  <div class="bloom bg-accent-strong -bottom-40 left-1/2 size-[36rem]" aria-hidden="true"></div>

  <Container size="wide" class="relative">
    <div class="reveal">
      <h2 id="contact-heading" class="text-4xl tracking-tighter sm:text-5xl">
        {t('contact.heading')}
      </h2>
      <p class="text-text-muted mt-4 max-w-2xl text-lg">{t('contact.lead')}</p>
    </div>

    <div class="reveal mt-12">
      <a
        href={`mailto:${site.email}`}
        class="text-text hover:text-accent focus-visible:text-accent group duration-base inline-flex max-w-full items-center gap-4 rounded-md text-2xl font-semibold tracking-tight transition-colors sm:text-4xl"
      >
        <span class="break-all">{site.email}</span>
        <span
          class="text-accent duration-base ease-out-expo transition-transform group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </a>
    </div>

    <ul class="reveal mt-16 grid gap-4 sm:grid-cols-2">
      {
        profiles.map((profile) => (
          <li>
            <a
              href={profile.href}
              rel="me noopener"
              class="border-border bg-surface-raised/60 hover:border-accent hover:bg-surface-raised group duration-base ease-out-expo flex items-center gap-4 rounded-xl border p-5 transition-[transform,border-color,background-color] hover:-translate-y-0.5"
            >
              <span
                class="border-border bg-surface text-text-muted group-hover:border-accent/40 group-hover:text-accent duration-base flex size-11 shrink-0 items-center justify-center rounded-lg border transition-colors"
                aria-hidden="true"
              >
                <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d={iconPaths[profile.icon]} />
                </svg>
              </span>

              <span class="min-w-0 flex-1">
                <span class="text-text-subtle block font-mono text-xs tracking-[0.15em] uppercase">
                  {profile.label}
                </span>
                <span class="text-text group-hover:text-accent duration-base mt-1 block truncate transition-colors">
                  {profile.handle}
                </span>
              </span>

              <span
                class="text-text-subtle group-hover:text-accent duration-base ease-out-expo shrink-0 transition-[transform,color] group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
