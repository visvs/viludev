---
import { formatDateRange } from '../lib/formatDateRange';
import type { Locale } from '@/lib/i18n';

interface Props {
  role: string;
  company: string;
  startDate: string;
  endDate: string | null;
  highlights: readonly string[];
  locale: Locale;
  presentLabel: string;
  isCurrent: boolean;
}

const { role, company, startDate, endDate, highlights, locale, presentLabel, isCurrent } =
  Astro.props;

const dateRange = formatDateRange(startDate, endDate, locale, presentLabel);
/** Machine-readable range, so the dates are not only a visual convention. */
const dateTime = endDate === null ? startDate : `${startDate}/${endDate}`;
---

<li class="border-border relative border-l pb-12 pl-8 last:pb-0">
  <span
    class={`absolute -left-[5px] top-2 size-[9px] rounded-full ${
      isCurrent ? 'bg-accent-strong ring-accent-strong/30 ring-4' : 'bg-border-strong'
    }`}
    aria-hidden="true"></span>

  <time datetime={dateTime} class="text-text-subtle font-mono text-sm">{dateRange}</time>

  <h3 class="text-text mt-2 text-xl font-semibold">{role}</h3>
  <p class="text-accent mt-1 font-medium">{company}</p>

  <ul class="mt-4 space-y-2">
    {
      highlights.map((highlight) => (
        <li class="text-text-muted flex gap-3 leading-relaxed">
          <span
            class="text-secondary mt-[0.6em] size-1 shrink-0 rounded-full bg-current"
            aria-hidden="true"
          />
          <span>{highlight}</span>
        </li>
      ))
    }
  </ul>
</li>
