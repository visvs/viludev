---
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Tag from '@/components/ui/Tag.astro';
import { skillGroups, spokenLanguages } from '@/data/skills';
import { useTranslations, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Flattened for the marquee. Duplicated once so the loop is seamless. */
const marqueeSkills = skillGroups.flatMap((group) => group.skills);
---

<Section id="skills" class="bg-surface-sunken relative overflow-hidden">
  <div class="bloom bg-secondary top-1/2 -left-40 size-[26rem]" aria-hidden="true"></div>

  <Container size="wide" class="relative">
    <div class="reveal">
      <h2 id="skills-heading" class="text-4xl tracking-tighter sm:text-5xl">
        {t('skills.heading')}
      </h2>
      <p class="text-text-muted mt-4 max-w-2xl text-lg">{t('skills.lead')}</p>
    </div>
  </Container>

  {
    /*
    A continuous band of the whole stack, mirroring how the reference palette
    reads. It pauses on hover and on focus, and stops entirely under
    reduced-motion, where it degrades to a plain scrollable row.
  */
  }
  <div
    class="marquee relative mt-16 flex overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
    aria-hidden="true"
  >
    <div class="marquee-track flex shrink-0 gap-3 pr-3">
      {marqueeSkills.map((skill) => <Tag class="whitespace-nowrap">{skill}</Tag>)}
    </div>
    <div class="marquee-track flex shrink-0 gap-3 pr-3">
      {marqueeSkills.map((skill) => <Tag class="whitespace-nowrap">{skill}</Tag>)}
    </div>
  </div>

  <Container size="wide" class="relative">
    <div class="mt-16 grid gap-x-8 gap-y-10 sm:grid-cols-2">
      {
        skillGroups.map((group) => (
          <div class="reveal border-border border-t pt-6">
            <h3 class="text-text-subtle font-mono text-sm tracking-[0.15em] uppercase">
              {t(group.labelKey)}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li>
                  <Tag>{skill}</Tag>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="reveal border-border mt-14 border-t pt-8">
      <h3 class="text-text-subtle font-mono text-sm tracking-[0.15em] uppercase">
        {t('skills.languagesHeading')}
      </h3>
      <ul class="mt-4 flex flex-wrap gap-x-10 gap-y-2">
        {
          spokenLanguages.map((language) => (
            <li class="flex items-baseline gap-2">
              <span class="text-text text-lg font-medium">{t(language.nameKey)}</span>
              <span class="text-text-subtle font-mono text-sm">{t(language.levelKey)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
